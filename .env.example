# Aplikacja
APP_NAME=CSEWiki API
APP_ENV=development
DEBUG=true

# Baza danych PostgreSQL (lokalny Docker Compose)
POSTGRES_USER=csewiki
POSTGRES_PASSWORD=csewiki_dev_password
POSTGRES_DB=csewiki
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://csewiki:csewiki_dev_password@localhost:5432/csewiki

# CORS (adresy frontendu w trakcie lokalnego pisania)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Lokalny katalog na wgrywane pliki i obrazki (na etapie dev)
UPLOAD_DIR=./storage
